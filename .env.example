# Copy to .env for local overrides; .env is not committed.
# Variables already set in the environment win over the file.
# Every variable is optional, the values below are the defaults.

# Address to listen on. Behind a reverse proxy, 127.0.0.1 accepts local
# connections only. IPv6 addresses work too, e.g. ::1.
#HOST=0.0.0.0

# Port to listen on.
#PORT=3000

# Public address of the site, for search engine and link preview tags and
# links in emails. In development mode the default is http://localhost:PORT.
#SITE_URL=https://www.taichichuan.mobi

# Directory with styles.css, fonts, images and favicon.ico.
#STATIC_DIR=dist

# Directory with the lessons, kept outside this repository; see src/lessons.rs
# for its layout. Set, the site has the lessons at /lessons and the members'
# pages (/register, /login, /account), for now only in development mode.
# Unset, there are none of these pages, and the settings below are not used.
#CONTENT_DIR=

# The members' database, created if missing.
#DATABASE_URL=sqlite://taichichuan-mobi.db

# Sender of the login emails.
#MAIL_FROM=Taiji-Timo <taichiwayfarer@gmail.com>

# SMTP server for the emails. Without SMTP_HOST they are not sent; the link in
# each is logged instead. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=the
# address, and an app password in the file SMTP_PASSWORD_FILE.
#SMTP_HOST=
#SMTP_PORT=465
# tls (from the start, port 465), starttls (port 587) or none.
#SMTP_ENCRYPTION=tls
#SMTP_USER=
#SMTP_PASSWORD_FILE=

# Development mode: live reload and no caching. On when set, even empty,
# unless "0" or "false". `just watch` sets it.
#DEV=

# Log filter, see tracing-subscriber's EnvFilter.
#RUST_LOG=taichichuan_mobi=debug,tower_http=info
